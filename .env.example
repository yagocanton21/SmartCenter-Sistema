# Porta exposta na VPS (padrão: 8093)
PORT=8093

# Fuso horário do container
TZ=America/Sao_Paulo

# Caminho do banco SQLite (já configurado para o volume persistente)
DB_PATH=/app/data/smartcenter.db

# Senha inicial opcional (mínimo 10 caracteres); se vazia, gerada no primeiro início.
INITIAL_ADMIN_PASSWORD=
# Habilite somente ao conectar um gateway e registrar cobranças na API.
WEBHOOK_SECRET=
# URL pública exata, incluindo https:// e porta quando aplicável.
PUBLIC_ORIGIN=
# Use true quando o acesso público estiver atrás de HTTPS.
COOKIE_SECURE=false
